# Recorded with fictional demo data only (SUNDIAL_SOURCE=fake).
Output docs/demo.gif
Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 720
Set Theme "Catppuccin Macchiato"
Env SUNDIAL_SOURCE "fake"

Type "./bin/sundial" Enter
Sleep 1.5s
Type "jj" Sleep 500ms
Enter Sleep 1.5s
Escape Sleep 500ms
Type "w" Sleep 1.5s
Type "jjj" Sleep 1s
Type "m" Sleep 1.5s
Ctrl+K Sleep 500ms
Type "next fri" Sleep 800ms
Enter Sleep 1.5s
Type "q"
